# Proprietary packages, local runtime data, secrets and raw analysis evidence.
*.deb
*.rpm
*.pkg.tar.xz
*.elf
*.pem
*.key
.env
work/
output/
.rea-cli/
**/*-results.json
**/*.log

# User-selected ELF inputs and reviewed result JSON belong in these folders.
!/Target/**/*.elf
!/Disassembled/**/*-results.json

# Keep native project caches and raw logs out of version control.
/Disassembled/**/.cache/
/Disassembled/**/.work/
/Disassembled/**/raw-logs/
