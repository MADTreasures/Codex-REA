# Proprietary packages, input binaries, secrets and raw analysis evidence.
*.deb
*.rpm
*.pkg.tar.xz
*.exe
*.elf
*.pem
*.key
.env
work/
output/
.rea-cli/
**/*-results.json
**/*.log

# Inputs are downloaded outside the checkout; do not recreate the old input folder.
/Target/
/downloads/
/.analysis-inputs/

# Reviewed result JSON belongs in the report tree.
!/Disassembled/**/*-results.json

# Native caches, raw logs and large archives are not normal Git outputs.
/Disassembled/**/.cache/
/Disassembled/**/.work/
/Disassembled/**/raw-logs/
/Disassembled/**/*.zip
/Disassembled/**/*.7z
/Disassembled/**/*.tar
/Disassembled/**/*.tar.*
/Disassembled/**/*.gz
/Disassembled/**/*.zst
/Disassembled/**/*.part-*
